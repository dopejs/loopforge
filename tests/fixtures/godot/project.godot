; Minimal Godot 4 project used to exercise the engine adapter against a real
; binary. Kept as small as the adapter's own checks allow: `doctor` requires a
; configured `run/main_scene` that resolves to a file that exists, and
; `run test` boots that scene headlessly.

config_version=5

[application]

config/name="Loopforge Engine Fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
charge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
